<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Deals PK</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; background-color: #f4f4f4; text-align: center; }
        header { background: #333; color: #fff; padding: 20px; font-size: 24px; font-weight: bold; }
        .container { padding: 20px; }
        .product-card { background: white; padding: 15px; margin: 20px auto; max-width: 300px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.2); }
        .buy-btn { background: #28a745; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; font-size: 16px; }
    </style>
</head>
<body>

    <header>Welcome to Smart Deals PK</header>

    <div class="container">
        <h2>Featured Product</h2>
        <div class="product-card">
            <h3>Smart Gadget</h3>
            <p>Best quality product at reasonable price.</p>
            <p><strong>Price: PKR 1,999</strong></p>
            <button class="buy-btn" onclick="alert('Order placed successfully!')">Buy Now</button>
        </div>
    </div>

</body>
</html>
